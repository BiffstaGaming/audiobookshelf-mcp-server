# Copy to .env (never commit it). Used by docker compose, or: node --env-file=.env dist/index.js

# Required
ABS_URL=http://192.168.1.10:13378
ABS_API_KEY=paste-your-audiobookshelf-api-key-here

# Optional
# ABS_LIBRARY_IDS=Audiobooks
# ABS_DEFAULT_LIBRARY=Audiobooks
# ABS_ENABLE_WRITE_TOOLS=false
# ABS_REQUEST_TIMEOUT_MS=30000
# ABS_MAX_RESULTS=50
# ABS_DESCRIPTION_MAX_CHARS=300
# ABS_STALLED_AFTER_DAYS=60
# ABS_CACHE_TTL_SECONDS=60
# LOG_LEVEL=info

# HTTP transport (Docker sets MCP_TRANSPORT=http and MCP_HTTP_HOST=0.0.0.0)
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_AUTH_TOKEN=generate-a-long-random-string
# MCP_HTTP_ALLOWED_HOSTS=mcp.example.com
